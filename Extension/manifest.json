{
    "manifest_version": 3,
    "name": "Privacy Browser",
    "version": "1.3.0",
    "description": "AI-powered privacy policy analysis with tracker & ad blocking - Know what data websites collect and block trackers",
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "permissions": [
        "activeTab",
        "sidePanel",
        "tabs",
        "storage",
        "declarativeNetRequest",
        "declarativeNetRequestFeedback"
    ],
    "host_permissions": [
        "<all_urls>",
        "https://privacybrowser-backend.onrender.com/*",
        "http://98.130.128.254/*",
        "http://localhost:5001/*"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "tracker_rules",
                "enabled": true,
                "path": "rules/trackers.json"
            }
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png",
            "48": "icons/48.png"
        },
        "default_title": "Privacy Browser - Tracker Blocking"
    }
}